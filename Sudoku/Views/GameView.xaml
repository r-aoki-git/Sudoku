<UserControl x:Class="Sudoku.Views.GameView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Sudoku.Views.Converters">
    <UserControl.Resources>
        <converters:BoxBorderThicknessConverter x:Key="BoxBorderThicknessConverter"/>


        <!-- 盤面の配色調整 -->
        <SolidColorBrush x:Key="CellNormalBrush" Color="White"/>
        <!--通常時のマス背景-->
        <SolidColorBrush x:Key="CellHoverBrush" Color="#CAFAFF"/>
        <!--マウスホバー時のマス背景-->
        <SolidColorBrush x:Key="CellHoverAssistBrush" Color="#CDEBFF"/>
        <!--マウスホバーアシスト（行・列対応）-->
        <SolidColorBrush x:Key="CellRelatedBrush" Color="#E0EFFF"/>
        <!--マス選択時の行・列・ブロック-->
        <SolidColorBrush x:Key="CellMatchRowColBrush" Color="#E1D5F5"/>
        <!--重複数字の行・列ハイライト-->
        <SolidColorBrush x:Key="CellSelectedBrush" Color="#90EAFF"/>
        <!--選択状態のマス背景-->
        <SolidColorBrush x:Key="CellConflictBackGroundBrush" Color="#FFDBD8"/>
        <!--重複時のマス背景-->
        <SolidColorBrush x:Key="GivenValueBrush" Color="Black"/>
        <!--初期配置された数字の文字色-->
        <SolidColorBrush x:Key="EnteredValueBrush" Color="#1565C0"/>
        <!--入力した数字の文字色-->
        <SolidColorBrush x:Key="ConflictValueBrush" Color="Red"/>
        <!--重複した数字の文字色-->
        <SolidColorBrush x:Key="CandidateTextBrush" Color="Gray"/>
        <!--メモした数字の文字色-->
        <SolidColorBrush x:Key="SameNumberBorderBrush" Color="#FF9800"/>
        <!--同じ数字のハイライト枠線-->
        <SolidColorBrush x:Key="CandidateHighlightBackgroundBrush" Color="#FF9800"/>
        <!--同じ数字のハイライト背景-->

        <!-- ボタン本体（背景色のみ担当。文字色は中身のTextBlockごとに制御する） -->
        <Style x:Key="CellButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CellNormalBrush}"/>
            <EventSetter Event="MouseEnter" Handler="Cell_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Cell_MouseLeave"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Cell_PreviewMouseLeftButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMatchRowColHighlight}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CellMatchRowColBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRelatedHighlight}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CellRelatedBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CellHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsHoverHighlight}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CellHoverAssistBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CellConflictBackGroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource CellSelectedBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 確定値の文字色（初期配置=黒太字／入力した数字=青／重複=赤 という優先順位） -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GivenValueBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGiven}" Value="False"/>
                        <Condition Binding="{Binding HasValue}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource EnteredValueBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ConflictValueBrush}"/>
                </DataTrigger>
                <!-- IsGivenを一番最後に置くことで、重複扱いになっても黒を維持する -->
                <DataTrigger Binding="{Binding IsGiven}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{StaticResource GivenValueBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CandidateTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CandidateTextBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="600" Height="730">
            <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackgroundBrush}" Padding="20,14">
                <Grid Cursor="">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="🏠 ホーム" Command="{Binding HomeCommand}"
                                Style="{StaticResource TopBarButtonStyle}" Margin="0,0,26,0" Cursor="Hand"/>
                        <Button Content="▶️ 新しいゲーム" Command="{Binding NewGameCommand}"
                                Style="{StaticResource TopBarButtonStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource HeadingTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="✏" ToolTip="メモモード切替"
                            Command="{Binding Board.ToggleMemoModeCommand}"
                            Style="{StaticResource MemoToggleButtonStyle}"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="5, 20">
                <UniformGrid Rows="1" Columns="10">
                    <Button Content="1" CommandParameter="1" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit1Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="2" CommandParameter="2" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit2Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="3" CommandParameter="3" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit3Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="4" CommandParameter="4" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit4Available}" Style="{StaticResource NumberPadButtonStyle}" Cursor="Hand"/>
                    <Button Content="5" CommandParameter="5" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit5Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="6" CommandParameter="6" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit6Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="7" CommandParameter="7" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit7Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="8" CommandParameter="8" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit8Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="9" CommandParameter="9" Command="{Binding Board.EnterDigitCommand}"
                            IsEnabled="{Binding Board.IsDigit9Available}" Style="{StaticResource NumberPadButtonStyle}"/>
                    <Button Content="⌫" Command="{Binding Board.ClearCommand}" Style="{StaticResource ClearPadButtonStyle}"/>
                </UniformGrid>
            </Border>

            <Grid>
                <ItemsControl ItemsSource="{Binding Board.Cells}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          PreviewMouseRightButtonDown="Board_PreviewMouseRightButtonDown">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="9" Columns="9" Width="530" Height="530"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource BoxBorderThicknessConverter}">
                                        <Binding Path="Row"/>
                                        <Binding Path="Col"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <Button Style="{StaticResource CellButtonStyle}">
                                    <Grid>
                                        <!-- 確定値（大きい文字） -->
                                        <TextBlock Text="{Binding DisplayText}" FontSize="26"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValue}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 候補値メモ（3×3ミニグリッド） -->
                                        <ItemsControl ItemsSource="{Binding Candidates}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValue}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <!-- キラーナンプレ：ケージ合計値はマスの左上に描かれるため、
                                                             そのままではメモの「1」と重なる。
                                                             合計値ラベルの高さ分だけメモ全体を下げて場所を空ける。
                                                             ラベルを持つマスだけを下げるとマスごとにメモの位置が
                                                             ずれるので、盤面全体（＝キラーの全マス）で揃える。

                                                             下側の余白は、ケージ枠線（マスの縁から3px内側）に
                                                             最下段のメモが重ならないようにするためのもの。 -->
                                                        <DataTrigger Binding="{Binding IsKillerCell}" Value="True">
                                                            <Setter Property="Margin" Value="0,13,0,3"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="3" Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="3">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="Padding" Value="4,1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource CandidateHighlightBackgroundBrush}"/>
                                                                    </DataTrigger>
                                                                    <!-- キラーは合計値ラベルの分だけメモの領域が狭いので、余白を詰める -->
                                                                    <DataTrigger Binding="{Binding DataContext.IsKillerCell, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                        <Setter Property="Padding" Value="3,0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Text}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CandidateTextStyle}">
                                                                    <Style.Triggers>
                                                                        <!-- 同上：キラーではメモの文字も1段小さくする -->
                                                                        <DataTrigger Binding="{Binding DataContext.IsKillerCell, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                            <Setter Property="FontSize" Value="10"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--同じ数字のマスを示す枠（クリックの邪魔にならないようIsHitTestVisible=False）-->
                                        <Border BorderBrush="{StaticResource SameNumberBorderBrush}" BorderThickness="3" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSameNumberHighlight}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- キラーナンプレ：ケージ合計値ラベル（ケージの左上のマスのみに表示される）。
                                             ケージの枠線はマスごとではなく、盤面全体に重ねた1本のPathで描く（下部を参照）。 -->
                                            <TextBlock Text="{Binding CageSumText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="#1F2937"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Margin="5,2,0,0" IsHitTestVisible="False"/>
                                        </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- キラーナンプレ：ケージの枠線。
                     マスごとにBorderを置くと、破線柄の位相がマスの寸法に依存して
                     辺ごとに濃さが変わってしまい、さらに同じケージの隣接マスの
                     境目で線が途切れる。盤面全体で1本のGeometryにまとめることで、
                     途切れのない均一な破線になる。
                     幅・高さは上のUniformGridと必ず一致させること。 -->
                <Path Data="{Binding Board.CageOutline}"
                      Width="530" Height="530"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="#1F2937" StrokeThickness="1.6"
                      StrokeDashArray="2 2" StrokeDashCap="Flat"
                      IsHitTestVisible="False"/>
            </Grid>
        </DockPanel>

            <!-- クリア時のポップアップ -->
            <Border Background="#88000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsClearPopupVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="20"
                        Padding="40" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="クリアしました！" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,28"/>

                        <Button Content="もう一度遊ぶ" Command="{Binding NewGameCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"/>
                        <Button Content="ホームへ" Command="{Binding HomeCommand}"
                                Style="{StaticResource TopBarButtonStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- 問題生成中のオーバーレイ（キラーナンプレは生成に数秒かかるため表示） -->
            <Border Background="#88000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="20"
                        Padding="40" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🧩" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="問題を生成中です……" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
