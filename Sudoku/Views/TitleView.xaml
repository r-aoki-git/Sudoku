<UserControl x:Class="Sudoku.Views.TitleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="20"
                Padding="56"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="ナンプレ" FontSize="46" FontWeight="Bold"
                           FontFamily="{StaticResource AppFontFamily}"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="お好みの難易度で挑戦しよう" FontSize="16"
                           Foreground="{StaticResource CardMutedTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <TextBlock Text="難易度" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource BodyTextBrush}" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding DifficultyOptions}"
                          SelectedItem="{Binding SelectedDifficulty}"
                          Style="{StaticResource AppComboBoxStyle}"
                          Margin="0,0,0,28"/>

                <Button Content="新しいゲーム" Command="{Binding StartGameCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,12"/>

                <Button Content="続きから" Command="{Binding ContinueGameCommand}"
                        IsEnabled="{Binding IsContinueAvailable}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
